# Matches docker-compose.dev.yml. Copy to .env for local development:
#   cp .env.dev.example .env
PORT=3100
API_KEY=local-dev-key

# Keep local session/upload data out of the repo.
PERSISTENT_DATA_PATH=/tmp/pearlnotify-data

REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# One shard locally is enough: with TOTAL_SHARDS=1 every institute maps to
# shard 0, so a single worker owns them all. Raise it only to test sharding.
WHATSAPP_TOTAL_SHARDS=1
WHATSAPP_SHARD_ID=0

WHATSAPP_WORKER_CONCURRENCY=10
WHATSAPP_PER_INSTITUTE_MAX_PER_MINUTE=5

MAX_UPLOAD_MB=15
FILE_STORE_TTL_HOURS=48

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=pearlnotify
DB_PASSWORD=pearlnotify
DB_NAME=pearlnotify
DB_CONNECTION_LIMIT=10
