# Hostinger supplies PORT automatically. For local development, 3100 is fine.
PORT=3100
API_KEY=change-this-to-a-long-random-secret

# IMPORTANT: keep this outside Hostinger hbuilds/current so redeploys do not orphan WhatsApp sessions.
# If omitted, v2 defaults to: $HOME/pearlnotify-data
PERSISTENT_DATA_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data

# Usually leave these unset and let them live below PERSISTENT_DATA_PATH.
# SESSION_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data/sessions
# STATE_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data/state
# UPLOAD_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data/uploads

# Redis + sharding
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WHATSAPP_TOTAL_SHARDS=16

# Initial KVM 2 worker tuning
WHATSAPP_WORKER_CONCURRENCY=10
WHATSAPP_PER_INSTITUTE_MAX_PER_MINUTE=5

MAX_UPLOAD_MB=15

# How long an attachment uploaded via POST /api/files stays sendable.
# Nothing deletes on send, because one file may go to many parents.
FILE_STORE_TTL_HOURS=48

# MySQL, used by src/db.js for the whatsapp_message audit trail.
# The API and every shard worker need these.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pearlnotify
DB_PASSWORD=change-me
DB_NAME=pearlnotify
DB_CONNECTION_LIMIT=10

# --- Browser restart guards (added after the 2026-09 runaway-CPU incident) ---
# A session on a QR/pairing screen can never send, so those jobs fail fast
# instead of relaunching Chrome. These cap how often a browser may be restarted
# for one institute, and stop trying entirely after repeated failures.
WHATSAPP_RECREATE_COOLDOWN_MS=300000
WHATSAPP_RECREATE_FAILURE_LIMIT=3
WHATSAPP_CIRCUIT_OPEN_MS=900000

# restoreAll() boots sessions one at a time. Chrome is ~556 MB and 11 processes
# per session, so launching them together is what exhausts the box.
WHATSAPP_RESTORE_STAGGER_MS=15000
WHATSAPP_RESTORE_INIT_TIMEOUT_MS=120000
