# Hostinger supplies PORT automatically. For local development, 3100 is fine.
PORT=3100
API_KEY=change-this-to-a-long-random-secret

# IMPORTANT: keep this outside Hostinger hbuilds/current so redeploys do not orphan WhatsApp sessions.
# If omitted, v2 defaults to: $HOME/pearlnotify-data
PERSISTENT_DATA_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data

# Usually leave these unset and let them live below PERSISTENT_DATA_PATH.
# SESSION_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data/sessions
# STATE_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data/state
# UPLOAD_PATH=/home/YOUR_HOSTINGER_USER/pearlnotify-data/uploads

# Redis + sharding
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WHATSAPP_TOTAL_SHARDS=16

# Initial KVM 2 worker tuning
WHATSAPP_WORKER_CONCURRENCY=10
WHATSAPP_PER_INSTITUTE_MAX_PER_MINUTE=5

MAX_UPLOAD_MB=15
